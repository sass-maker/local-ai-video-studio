{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planner discovery shard manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["shard_id", "schema_version", "record_count", "teacher", "status", "generation_runs", "records"],
  "properties": {
    "shard_id": { "const": "pilot-001" },
    "schema_version": { "const": "discovery-v0" },
    "record_count": { "const": 20 },
    "teacher": { "const": "devin/glm-5.2" },
    "status": { "enum": ["planned", "generated", "validated", "reviewed"] },
    "generation_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "disposition"],
        "properties": {
          "run_id": { "type": "string" },
          "disposition": { "enum": ["accepted", "accepted_with_normalization", "rejected"] }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^pilot-001-[0-9]{3}$" }
    }
  }
}
